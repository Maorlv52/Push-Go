{
  "name": "push-and-go",
  "displayName": "Push&Go",
  "description": "WebStorm-like Git sidebar for fast Commit / Push / Commit+Push.",
  "version": "0.0.5",
  "publisher": "Maorlevinshtein",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/maorlevinshtein/Push-Go.git"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onView:pushGo.sidebar",
    "onCommand:pushGo.open",
    "onCommand:pushGo.commit",
    "onCommand:pushGo.commitPush",
    "onCommand:pushGo.stageFile",
    "onCommand:pushGo.unstageFile",
    "onCommand:pushGo.discardFile",
    "onCommand:pushGo.openDiffFile",
    "onCommand:pushGo.commitThisFile",
    "onCommand:pushGo.createTag",
    "onCommand:pushGo.pushTag",
    "onCommand:pushGo.createAndPushTag"
  ],
  "extensionDependencies": [
    "vscode.git"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "pushGo",
          "title": "Push&Go",
          "icon": "media/pushgo.svg"
        }
      ]
    },
    "views": {
      "pushGo": [
        {
          "type": "webview",
          "id": "pushGo.sidebar",
          "name": "Push&Go",
          "icon": "media/pushgo.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "pushGo.open",
        "title": "Push&Go: Focus"
      },
      {
        "command": "pushGo.commit",
        "title": "Push&Go: Commit"
      },
      {
        "command": "pushGo.commitPush",
        "title": "Push&Go: Commit + Push"
      },
      {
        "command": "pushGo.stageFile",
        "title": "Push&Go: Stage"
      },
      {
        "command": "pushGo.unstageFile",
        "title": "Push&Go: Unstage"
      },
      {
        "command": "pushGo.discardFile",
        "title": "Push&Go: Discard"
      },
      {
        "command": "pushGo.openDiffFile",
        "title": "Push&Go: Open Diff"
      },
      {
        "command": "pushGo.commitThisFile",
        "title": "Push&Go: Commit This File(s)"
      },
      {
        "command": "pushGo.createTag",
        "title": "Create Tag",
        "category": "Push&Go"
      },
      {
        "command": "pushGo.pushTag",
        "title": "Push Tag",
        "category": "Push&Go"
      },
      {
        "command": "pushGo.createAndPushTag",
        "title": "Create & Push Tag",
        "category": "Push&Go"
      }
    ],
    "submenus": [
      {
        "id": "pushGo.explorer",
        "label": "Push&Go"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "submenu": "pushGo.explorer",
          "group": "navigation@99",
          "when": "gitOpenRepositoryCount != 0 && resourceScheme == file"
        }
      ],
      "pushGo.explorer": [
        {
          "command": "pushGo.stageFile",
          "group": "1_mod"
        },
        {
          "command": "pushGo.unstageFile",
          "group": "1_mod"
        },
        {
          "command": "pushGo.discardFile",
          "group": "1_mod"
        },
        {
          "command": "pushGo.openDiffFile",
          "group": "2_nav"
        },
        {
          "command": "pushGo.commitThisFile",
          "group": "3_commit"
        }
      ]
    },
    "configuration": {
      "title": "Push&Go",
      "properties": {
        "pushGo.enableWipGuard": {
          "type": "boolean",
          "default": false,
          "description": "Block commit when the message contains 'WIP' (case-insensitive)."
        },
        "pushGo.blockCommitOnMain": {
          "type": "boolean",
          "default": true,
          "description": "Ask for confirmation before committing on 'main' or 'master'."
        }
      }
    },
    "keybindings": [
      {
        "command": "pushGo.commit",
        "key": "cmd+enter",
        "mac": "cmd+enter",
        "when": "view == pushGo.sidebar"
      },
      {
        "command": "pushGo.commitPush",
        "key": "cmd+shift+enter",
        "mac": "cmd+shift+enter",
        "when": "view == pushGo.sidebar"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -w -p .",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/vscode": "^1.102.0",
    "@vscode/vsce": "^3.6.0",
    "typescript": "^5.9.2"
  }
}
